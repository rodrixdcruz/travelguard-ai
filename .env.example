[TEMPLATE]
# ── TravelGuard AI — environment template ─────────────────────────────
# Copy to .env and fill in values. NEVER commit real secrets.
#
# The app runs fully functional with ZERO keys: it defaults to LIVE MODE
# and pulls real data from key-less providers (OpenStreetMap Overpass for
# places/food/services, Open-Meteo for weather). Anything that cannot be
# served live is labeled DEMO or ESTIMATED in the API response and UI —
# never silently presented as live.

APP_NAME=TravelGuard AI
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (optional). When set, analyzed journeys persist and are served
# by GET /api/journeys/recent; without it the API behaves as demo mode
# (no DB writes). Live deployment uses a Neon PostgreSQL connection string.
DATABASE_URL=postgresql+psycopg://travelguard:travelguard@localhost:5432/travelguard

# ── Live provider configuration ───────────────────────────────────────
# Currently CONNECTED (no key required):
#   places/food/services → OpenStreetMap Overpass  (key-less)
#   weather (routes + discovery) → Open-Meteo      (key-less)
# Currently ESTIMATED (modeled rates; no live provider wired):
#   transport fares, ticket prices, meal costs
#
# Optional live providers (wire them only if you obtain credentials):
# WEATHER_API_KEY=          # e.g. OpenWeatherMap — overrides Open-Meteo if wired
# ROUTING_API_URL=          # live road routing/traffic for route segments
# ACCIDENT_API_KEY=         # accident-history provider for segment risk
# MAPS_API_KEY=             # e.g. Google Maps — if you add a maps provider
# PLACES_API_KEY=           # e.g. Google Places — richer POI details
# TRANSPORT_API_KEY=        # e.g. live transit/fares provider
# TICKETS_API_KEY=          # e.g. ticketing/booking availability provider

# AI provider (OpenAI-compatible). Optional — deterministic fallback is used if empty.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# CORS / frontend origin
# Local dev: http://localhost:5173 · Production (Render): your frontend origin,
# e.g. https://travelguard-web.onrender.com — Vercel preview URLs (*.vercel.app)
# are also accepted automatically via a backend CORS pattern.
FRONTEND_URL=http://localhost:5173

# Frontend (Vite) — copy to frontend/.env.local if you need a non-default backend
VITE_API_BASE_URL=
